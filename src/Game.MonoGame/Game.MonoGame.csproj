<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Game.MonoGameClient</RootNamespace>
    <AssemblyName>Game.MonoGame</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <PropertyGroup>
    <SteamWindows Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">true</SteamWindows>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Facepunch.Steamworks.Posix" Condition="'$(SteamWindows)' != 'true'"><HintPath>../../vendor/facepunch-2.5.2/Facepunch.Steamworks.Posix.dll</HintPath></Reference>
    <Reference Include="Facepunch.Steamworks.Win64" Condition="'$(SteamWindows)' == 'true'"><HintPath>../../vendor/facepunch-2.5.2/Facepunch.Steamworks.Win64.dll</HintPath></Reference>
    <Content Include="../../vendor/facepunch-2.5.2/linux-x64/libsteam_api.so" Condition="'$(SteamWindows)' != 'true'" Link="libsteam_api.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/facepunch-2.5.2/win-x64/steam_api64.dll" Condition="'$(SteamWindows)' == 'true'" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Game.Shared/Game.Shared.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="Gum.MonoGame" Version="2026.1.31.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../assets/**/*" Link="assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../tools/session-probe/OpeningProbe.cs" Link="Development/OpeningProbe.cs" /></ItemGroup>
</Project>
